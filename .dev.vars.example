# Copy this file to .dev.vars for local `wrangler dev` runs.
# .dev.vars is gitignored — never commit real secrets.
# In production these are set with `wrangler secret put <NAME>` instead.

GROQ_API_KEY=your_groq_api_key_here
# Optional; defaults to openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b
VERIFY_TOKEN=choose_any_shared_secret_string
# Dashboard login
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me
SESSION_SECRET=random_long_string_here

# Optional legacy URL token fallback, only used when login secrets are not configured.
DASHBOARD_TOKEN=optional_dashboard_token
